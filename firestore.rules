rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVendor() {
      return isSignedIn() && userDoc().role == 'vendor';
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function myVenueId() {
      return userDoc().venueId;
    }

    function hasLinkedVenue() {
      return myVenueId() != null;
    }

    function ownsVenue(venueId) {
      return isVendor() && myVenueId() == venueId;
    }

    function verifiedOrLegacyVendor() {
      return isVendor() && (hasVerifiedEmail() || hasLinkedVenue());
    }

    function userProtectedFields() {
      return ['role', 'venueId', 'emailVerified', 'emailVerifiedAt', 'onboardingComplete'];
    }

    function userProtectedFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields());
    }

    function emailVerifiedWriteIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['emailVerified'])
        || request.resource.data.emailVerified == true;
    }

    function roleWriteIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || request.resource.data.role == resource.data.role;
    }

    function requestedVenueOwnedByUser() {
      return !request.resource.data.keys().hasAny(['venueId'])
        || request.resource.data.venueId == null
        || (
          exists(/databases/$(database)/documents/venues/$(request.resource.data.venueId))
          && get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.ownerId == request.auth.uid
        );
    }

    function legacyVenueLinkOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['venueId', 'hallName', 'onboardingComplete', 'updatedAt']);
    }

    function legacyZaydanClaim(venueId) {
      return venueId == 'zaydan-banquet-hall'
        && isVendor()
        && !hasLinkedVenue()
        && !userDoc().keys().hasAny(['pendingVendorOnboarding'])
        && resource.data.ownerId == null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          !request.resource.data.keys().hasAny(['venueId'])
          || request.resource.data.venueId == null
        );
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (
          !userProtectedFieldsChanged()
          || (
            hasVerifiedEmail()
            && requestedVenueOwnedByUser()
            && roleWriteIsSafe()
            && emailVerifiedWriteIsSafe()
          )
          || (
            legacyVenueLinkOnly()
            && requestedVenueOwnedByUser()
          )
        );
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isVendor()
        && hasVerifiedEmail()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if (
        ownsVenue(venueId)
        && (hasVerifiedEmail() || hasLinkedVenue())
      ) || legacyZaydanClaim(venueId);
      allow delete: if ownsVenue(venueId) && hasVerifiedEmail();
    }

    match /inventory_listings/{listingId} {
      allow read: if verifiedOrLegacyVendor();
      allow create: if verifiedOrLegacyVendor()
        && request.resource.data.lenderVenueId == myVenueId();
      allow update, delete: if verifiedOrLegacyVendor()
        && resource.data.lenderVenueId == myVenueId();
    }

    match /borrow_requests/{requestId} {
      allow read: if verifiedOrLegacyVendor() && (
        resource.data.borrowerVenueId == myVenueId() ||
        resource.data.lenderVenueId == myVenueId()
      );
      allow create: if verifiedOrLegacyVendor()
        && request.resource.data.borrowerVenueId == myVenueId()
        && request.resource.data.borrowerUserId == request.auth.uid
        && request.resource.data.borrowerVenueId != request.resource.data.lenderVenueId
        && request.resource.data.status == 'pending_lender_approval';
      allow update: if verifiedOrLegacyVendor() && (
        resource.data.lenderVenueId == myVenueId() ||
        (resource.data.borrowerVenueId == myVenueId()
          && resource.data.status == 'pending_lender_approval')
      );
    }

    match /bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }

    match /quotations/{quotationId} {
      allow read, write: if isSignedIn();
    }
  }
}
